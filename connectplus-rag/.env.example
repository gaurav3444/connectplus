# Copy to .env and fill in. .env is gitignored; this template is not.

# Supabase Postgres - use the SESSION POOLER connection string
# (dashboard -> Connect -> "Session pooler"), NOT "Direct connection" and
# NOT "Project URL". Confirmed real issue: the direct connection only
# resolves over IPv6 by default and fails with "No route to host" on
# networks that don't route IPv6. The pooler works over IPv4.
DATABASE_URL=
