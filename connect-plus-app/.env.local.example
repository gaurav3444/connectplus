# Copy to .env.local. Every value is optional: with none set the app runs on
# its built-in sample answers and lessons.

# connectplus-llm, which answers Ask a question. It runs connectplus-rag
# inside it, so this is the only answer service to point at:
#   cd connectplus-llm && CONNECTPLUS_RAG=real uvicorn demo.server:app --port 8000
# (CONNECTPLUS_RAG=stub and LLM_PROVIDER=mock run it offline, no keys.)
LLM_API_URL=http://localhost:8000

# Supabase, for the Browse topics menu and its lessons. connectplus-rag's
# `python -m rag.main browse --build` fills the browse_resources table; the app
# only reads it. Project URL and the anon (public) key: dashboard -> Project
# Settings -> API. Leave empty to use the built-in sample lessons.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs the session cookie. Any long random string in production.
SESSION_SECRET=
