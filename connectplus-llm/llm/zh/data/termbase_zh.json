  "query_expansion": {
    "_why": [
      "Chinese intent to English retrieval terms, with no model involved.",
      "This is the deterministic floor: when the LLM rewrite is unavailable",
      "or returns something unusable, retrieval still gets real search",
      "terms instead of a generic string. Every answer records which path",
      "won, so the two can be told apart in the eval."
    ],
