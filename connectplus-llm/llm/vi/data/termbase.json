  "register": {
    "_comment": [
      "Vietnamese has no neutral second person. Every sentence commits to a",
      "relationship. Addressing a 75-year-old as 'ban' (peer) is not informal,",
      "it is disrespectful, and for a service built for seniors that is a",
      "product failure, not a style nit."
    ],
    "preferred_address": [
      "ông",
      "bà",
      "quý vị",
      "ông/bà"
    ],
    "forbidden_address": [
      "bạn",
      "mày",
      "cậu",
      "em"
    ],
    "self_reference": "chúng tôi",
    "note": "Default to 'ông/bà'. 'quý vị' is acceptable when the sentence addresses the reader generally."
  },
  "plain_language": {
    "_comment": [
      "Sino-Vietnamese formal register. Each of these is correct Vietnamese and",
      "each has a plain everyday equivalent. Government and telco pages are",
