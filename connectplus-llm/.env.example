# Copy to .env and fill in. .env is gitignored; this template is not.

# Supabase Postgres - use the SESSION POOLER connection string
# (dashboard -> Connect -> "Session pooler"), NOT "Direct connection" and
# NOT "Project URL". Confirmed real issue: the direct connection only
# resolves over IPv6 by default and fails with "No route to host" on
# networks that don't route IPv6. The pooler works over IPv4.
DATABASE_URL=

# Copy to .env and fill in. Never commit .env.
# Everything runs with no key at all -- it falls back to the offline stub.

# mock | gemini | ollama
LLM_PROVIDER=gemini

# Put the offline provider behind the network one, so a dead quota
# degrades the answer instead of refusing it.
LLM_FALLBACK=ollama
LLM_ALLOW_FALLBACK=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# One JSON line per provider call. Safe to paste into a report:
# no prompts, no answers, no keys.
TRACE_FILE=traces.jsonl

